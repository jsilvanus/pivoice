[Unit]
Description=PiVoice Microphone Capture and Live Captions
After=network-online.target

[Service]
WorkingDirectory=%h/apps/pivoice
EnvironmentFile=%h/apps/pivoice.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/node src/main.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
